{
  "name": "ebook-ai-reader",
  "productName": "eBook AI Reader",
  "version": "1.0.0",
  "description": "AI 驱动的智能电子书阅读器 - 支持 PDF/EPUB/TXT，集成 AI 辅助阅读",
  "author": "eBook AI Reader",
  "main": "electron/main.js",
  "scripts": {
    "build": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "start": "webpack --mode development && electron .",
    "dev": "webpack --mode development && electron .",
    "pack": "webpack --mode production && electron-builder --dir",
    "dist": "webpack --mode production && electron-builder"
  },
  "build": {
    "appId": "com.ebook-ai-reader.app",
    "productName": "eBook AI Reader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "eBook AI Reader"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.10.0",
    "electron": "^28.2.0",
    "electron-builder": "^26.15.3",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.0.379",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
